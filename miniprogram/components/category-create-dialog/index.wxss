.dialog-layer {
  position: fixed;
  inset: 0;
  z-index: 72;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(42, 35, 28, 0.55);
}

.dialog-card {
  width: 100%;
  max-width: 560rpx;
  padding: 36rpx 34rpx 32rpx;
  background: #fffdf8;
  border: 3rpx solid rgba(70, 63, 58, 0.16);
  border-radius: 28rpx;
  box-shadow: 0 22rpx 56rpx rgba(70, 63, 58, 0.18);
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
  color: #463f3a;
}

.dialog-subtitle {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.45;
  text-align: center;
  color: #82756c;
}

.name-input {
  width: 100%;
  height: 78rpx;
  margin-top: 26rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(70, 63, 58, 0.18);
  border-radius: 18rpx;
}

.icon-label {
  margin-top: 24rpx;
  font-size: 25rpx;
  font-weight: 900;
  color: #463f3a;
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.icon-option {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffaf0;
  border: 2rpx solid rgba(70, 63, 58, 0.14);
  border-radius: 16rpx;
}

.icon-option.active {
  background: #ffe29b;
  border-color: #463f3a;
  box-shadow: 0 5rpx 12rpx rgba(70, 63, 58, 0.12);
}

.icon-image {
  width: 48rpx;
  height: 48rpx;
}

.dialog-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn {
  width: 100%;
  min-width: 0;
  height: 76rpx;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
}

.btn.ghost {
  background: #fffdf8;
  border: 2rpx solid rgba(70, 63, 58, 0.24);
}

.btn.primary {
  background: #ffe29b;
  border: 2rpx solid rgba(70, 63, 58, 0.14);
}

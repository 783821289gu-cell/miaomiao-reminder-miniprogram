.sheet-layer{position:fixed;inset:0;z-index:62;display:flex;align-items:flex-end;background:rgba(42,35,28,.5)}
.ai-sheet{width:100%;max-height:88vh;box-sizing:border-box;padding:18rpx 28rpx calc(env(safe-area-inset-bottom) + 24rpx);background:#fffdf8;border:3rpx solid rgba(70,63,58,.16);border-radius:34rpx 34rpx 0 0;box-shadow:0 -18rpx 48rpx rgba(70,63,58,.2)}
.sheet-drag-zone{padding:0 0 18rpx}.sheet-handle{width:86rpx;height:8rpx;margin:0 auto 20rpx;background:#d8c8bd;border-radius:999rpx}.sheet-title{font-size:34rpx;font-weight:900;color:#463f3a}.sheet-tip{margin-top:8rpx;font-size:24rpx;font-weight:700;color:#82756c}.operation-list{max-height:60vh}.operation-card{margin-bottom:16rpx;padding:18rpx;background:#fffaf0;border:2rpx solid rgba(70,63,58,.14);border-radius:22rpx}.operation-head{display:grid;grid-template-columns:auto minmax(0,1fr) 56rpx;gap:12rpx;align-items:center}.action-badge{padding:8rpx 16rpx;font-size:22rpx;font-weight:900;color:#fff;background:#2fc8a7;border-radius:999rpx}.action-badge.delete{background:#eb5f91}.action-badge.update,.action-badge.set_reminder{background:#d5a64f}.action-badge.unpin{background:#8776bc}.operation-message{display:-webkit-box;overflow:hidden;font-size:24rpx;font-weight:800;line-height:1.35;color:#463f3a;-webkit-box-orient:vertical;-webkit-line-clamp:2}.delete-op-hit{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center}.delete-op{width:46rpx;height:46rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:900;color:#eb5f91;background:#fffdf8;border:2rpx solid rgba(235,95,145,.18);border-radius:50%}.possible-tip{margin-top:12rpx;padding:10rpx 14rpx;font-size:22rpx;font-weight:700;color:#a8792a;background:#fff2c9;border-radius:12rpx}.field-grid{margin-top:14rpx;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12rpx}.field-grid.inner{margin-top:10rpx}.field.wide,.change-block.wide{grid-column:1/-1}.label,.change-title{margin-bottom:8rpx;font-size:22rpx;font-weight:800;color:#82756c}.input{width:100%;height:66rpx;box-sizing:border-box;padding:0 18rpx;font-size:25rpx;background:#fffdf8;border:2rpx solid rgba(70,63,58,.14);border-radius:16rpx}.event-select{min-height:70rpx;padding:12rpx 16rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;background:#fffdf8;border:2rpx solid rgba(70,63,58,.14);border-radius:16rpx}.event-select-title{font-size:25rpx;font-weight:800;color:#463f3a}.event-select-date{margin-top:4rpx;font-size:20rpx;color:#9a8d83}.event-select-arrow{font-size:38rpx;color:#b5a89e}.change-block{padding:14rpx;background:rgba(255,226,155,.22);border-radius:16rpx}.reminder-modes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx}.reminder-mode{min-height:76rpx;padding:10rpx 4rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:24rpx;font-weight:900;background:#fffdf8;border:2rpx solid rgba(70,63,58,.14);border-radius:16rpx}.reminder-mode.active{background:#ffe29b;border-color:#d5a64f}.reminder-mode .sub{margin-top:3rpx;font-size:18rpx;font-weight:600;color:#82756c}.reminder-time{margin-top:12rpx}.sheet-actions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18rpx;margin-top:18rpx}.btn{width:100%;min-width:0;height:78rpx;font-size:27rpx;font-weight:900;border-radius:999rpx}.btn.ghost{background:#fffdf8;border:2rpx solid rgba(70,63,58,.22)}.btn.primary{background:#ffe29b;border:2rpx solid rgba(70,63,58,.16)}
.sub-layer{position:fixed;inset:0;z-index:70;display:flex;align-items:flex-end;background:rgba(42,35,28,.45)}.sub-card{width:100%;max-height:72vh;box-sizing:border-box;padding:24rpx 28rpx calc(env(safe-area-inset-bottom) + 24rpx);background:#fffdf8;border-radius:30rpx 30rpx 0 0}.sub-title{text-align:center;font-size:30rpx;font-weight:900;color:#463f3a}.event-options{max-height:48vh;margin-top:18rpx}.event-option{padding:18rpx;margin-bottom:10rpx;background:#fffaf0;border:2rpx solid rgba(70,63,58,.12);border-radius:16rpx}.event-option-title{font-size:26rpx;font-weight:900}.event-option-date{margin-top:6rpx;font-size:22rpx;color:#82756c}.sub-cancel{height:72rpx;margin-top:14rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:900;border:2rpx solid rgba(70,63,58,.18);border-radius:999rpx}.selected-time{margin:10rpx 0;text-align:center;font-size:25rpx;font-weight:800;color:#82756c}.reminder-wheel{height:330rpx}.wheel-item{height:68rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#9d9188}.wheel-indicator{height:68rpx;background:#fff4dc;border-radius:14rpx}.sub-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:18rpx}.sub-action{height:72rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:900;border-radius:999rpx}.sub-action.ghost{border:2rpx solid rgba(70,63,58,.18)}.sub-action.primary{background:#ffe29b;border:2rpx solid rgba(213,166,79,.4)}

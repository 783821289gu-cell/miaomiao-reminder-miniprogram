.sheet-layer {
  position: fixed;
  inset: 0;
  z-index: 54;
  display: flex;
  align-items: flex-end;
  background: rgba(42, 35, 28, 0.45);
}

.import-sheet {
  width: 100%;
  padding: 0 30rpx calc(env(safe-area-inset-bottom) + 36rpx);
  background: #fffdf8;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -16rpx 44rpx rgba(70, 63, 58, 0.18);
  transition: transform 180ms ease;
}

.sheet-drag-zone {
  margin: 0 -30rpx;
  padding: 18rpx 30rpx 14rpx;
}

.sheet-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  background: #d8cbc1;
  border-radius: 999rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
}

.sheet-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #82756c;
}

.ai-import-state {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  font-size: 21rpx;
  font-weight: 800;
  color: #82756c;
  background: #fff4dc;
  border: 2rpx solid rgba(70, 63, 58, 0.1);
  border-radius: 999rpx;
}

.ai-import-state.on {
  color: #216f60;
  background: #e9f7ef;
  border-color: rgba(47, 200, 167, 0.2);
}

.image-import-btn {
  width: 100%;
  height: 72rpx;
  margin-top: 16rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #463f3a;
  background: #fff4dc;
  border: 2rpx solid rgba(70, 63, 58, 0.16);
  border-radius: 999rpx;
}

.image-import-btn::after {
  border: 0;
}

.image-import-icon {
  width: 34rpx;
  height: 34rpx;
}

.text-area {
  width: 100%;
  height: 270rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  font-size: 26rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(70, 63, 58, 0.16);
  border-radius: 20rpx;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 14rpx;
  margin-top: 24rpx;
}

.btn {
  width: 100%;
  min-width: 0;
  height: 76rpx;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 999rpx;
}

.btn.ghost {
  background: #fffdf8;
  border: 2rpx solid rgba(70, 63, 58, 0.24);
}

.btn.primary {
  background: #ffe29b;
  border: 2rpx solid rgba(70, 63, 58, 0.14);
}

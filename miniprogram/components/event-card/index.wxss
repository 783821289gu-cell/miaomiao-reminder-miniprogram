@import "../../styles/background-templates.wxss";

.swipe-shell {
  position: relative;
  width: 100%;
  margin-bottom: 16rpx;
  overflow: visible;
  border-radius: 28rpx;
}

.delete-action {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fffdf8;
  background: #e86f84;
  border: 3rpx solid rgba(70, 63, 58, 0.12);
  border-radius: 26rpx;
  box-shadow: 0 10rpx 22rpx rgba(232, 111, 132, 0.22);
  opacity: 0;
  transform: translateX(12rpx) scale(0.98);
  transition: opacity 180ms ease, transform 180ms ease;
}

.delete-icon {
  width: 38rpx;
  height: 38rpx;
}

.delete-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.swipe-shell.opened .delete-action,
.swipe-shell.dragging .delete-action {
  opacity: 1;
  transform: translateX(0) scale(1);
}

.event-card {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 138rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #fffdf8;
  background-repeat: repeat;
  background-size: 160rpx 160rpx;
  border: 4rpx solid rgba(70, 63, 58, 0.24);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(70, 63, 58, 0.08);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.card-bg-image {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.swipe-shell.dragging .event-card,
.swipe-shell.opened .event-card {
  box-shadow: 0 14rpx 30rpx rgba(70, 63, 58, 0.13);
}

.event-card.today {
  background-color: #fff0c6;
  border-color: rgba(235, 95, 145, 0.5);
}

.event-card.pinned {
  border-color: rgba(255, 179, 64, 0.82);
  box-shadow: 0 12rpx 26rpx rgba(255, 179, 64, 0.18);
}

.event-card.pin-dragging {
  transform: scale(1.015);
  box-shadow: 0 18rpx 36rpx rgba(70, 63, 58, 0.18);
}

.card-left,
.card-right {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.card-left {
  flex: 1;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.event-title {
  min-width: 0;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
  color: #463f3a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pin-pill {
  flex: none;
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  font-weight: 900;
  color: #8b5a16;
  background: #fff0be;
  border: 2rpx solid rgba(139, 90, 22, 0.22);
  border-radius: 999rpx;
}

.reminder-pill {
  flex: none;
  padding: 6rpx 13rpx;
  color: #187a68;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
  background: #dff8ef;
  border: 2rpx solid rgba(24, 122, 104, 0.2);
  border-radius: 999rpx;
}

.event-date {
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 800;
  color: #82756c;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  display: inline-flex;
  min-width: 78rpx;
  margin-top: 16rpx;
  padding: 7rpx 16rpx;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  color: #fff;
  background: #2fc8a7;
  border-radius: 999rpx;
}

.status-pill.today {
  background: #eb5f91;
}

.status-pill.past {
  background: #b9aaa0;
}

.card-right {
  flex: none;
  min-width: 132rpx;
  margin-left: 20rpx;
  text-align: right;
}

.count-wrap {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
}

.count-number {
  font-family: "DIN Alternate", "PingFang SC", sans-serif;
  font-size: 66rpx;
  font-weight: 900;
  line-height: 1;
  color: #5a3b25;
}

.count-unit {
  font-size: 24rpx;
  font-weight: 900;
  color: #5a3b25;
}

.count-today {
  display: inline-flex;
  padding: 10rpx 24rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #eb5f91;
  background: rgba(255, 253, 248, 0.82);
  border: 2rpx solid rgba(235, 95, 145, 0.22);
  border-radius: 999rpx;
}

.meta-text {
  margin-top: 12rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 900;
  color: #82756c;
  text-overflow: ellipsis;
  white-space: nowrap;
}

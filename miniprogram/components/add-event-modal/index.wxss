@import "../../styles/background-templates.wxss";

.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(42, 35, 28, 0.55);
  animation: fade-in 180ms ease-out;
}

.modal-card {
  width: 100%;
  max-width: 600rpx;
  max-height: 90vh;
  padding: 34rpx;
  overflow-y: auto;
  background: #fffdf8;
  border: 3rpx solid rgba(70, 63, 58, 0.18);
  border-radius: 28rpx;
  box-shadow: 0 24rpx 60rpx rgba(70, 63, 58, 0.2);
  animation: pop-in 220ms ease-out;
}

.modal-title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.field {
  margin-top: 18rpx;
}

.field-label {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #82756c;
}

.text-input,
.date-row {
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(70, 63, 58, 0.24);
  border-radius: 18rpx;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-placeholder {
  color: #b9aaa0;
}

.date-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-icon {
  width: 42rpx;
  height: 42rpx;
}

.reminder-time-row {
  font-weight: 800;
}

.chip-row,
.bg-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 14rpx 22rpx;
  font-size: 24rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(70, 63, 58, 0.14);
  border-radius: 999rpx;
}

.chip.active {
  background: #ffe29b;
  border-color: #463f3a;
}

.reminder-mode-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.reminder-summary-card {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
  align-items: center;
  background: #fff9e9;
  border: 2rpx solid rgba(70, 63, 58, 0.14);
  border-radius: 20rpx;
}

.reminder-summary-card.triggered {
  background: #edf8f1;
  border-color: rgba(43, 156, 132, 0.28);
}

.reminder-summary-copy {
  min-width: 0;
  flex: 1;
}

.reminder-summary-title {
  color: #2b9c84;
  font-size: 24rpx;
  font-weight: 900;
}

.reminder-summary-time {
  margin-top: 6rpx;
  color: #463f3a;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.5;
  word-break: break-all;
}

.reminder-summary-note {
  margin-top: 5rpx;
  color: #91847b;
  font-size: 19rpx;
  font-weight: 700;
}

.reminder-edit-button {
  flex: none;
  min-width: 92rpx;
  padding: 15rpx 18rpx;
  color: #7a511c;
  font-size: 23rpx;
  font-weight: 900;
  text-align: center;
  background: #ffe29b;
  border: 2rpx solid rgba(122, 81, 28, 0.2);
  border-radius: 999rpx;
}

.reminder-mode {
  min-width: 0;
  padding: 16rpx 8rpx;
  text-align: center;
  background: #fffaf0;
  border: 2rpx solid rgba(70, 63, 58, 0.14);
  border-radius: 20rpx;
}

.reminder-mode.active {
  background: #ffe29b;
  border-color: rgba(70, 63, 58, 0.42);
  box-shadow: 0 8rpx 18rpx rgba(70, 63, 58, 0.08);
}

.reminder-mode-title {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 900;
  color: #463f3a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-mode-sub {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #82756c;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-warning {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #eb5f91;
  background: #fff4dc;
  border: 2rpx solid rgba(235, 95, 145, 0.14);
  border-radius: 16rpx;
}

.reminder-error {
  margin: 12rpx 0;
  padding: 16rpx 18rpx;
  color: #b64068;
  font-size: 24rpx;
  line-height: 1.45;
  background: #fff0f5;
  border: 2rpx solid rgba(235, 95, 145, 0.24);
  border-radius: 14rpx;
}

.reminder-setting-note {
  margin-top: 12rpx;
  color: #82756c;
  font-size: 22rpx;
  line-height: 1.4;
}

.bg-dot {
  width: 58rpx;
  height: 58rpx;
  background-size: 120rpx 120rpx;
  border: 3rpx solid rgba(70, 63, 58, 0.14);
  border-radius: 50%;
}

.bg-dot.selected {
  border-color: #463f3a;
  box-shadow: 0 0 0 5rpx rgba(255, 226, 155, 0.7);
}

.option-row {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(70, 63, 58, 0.14);
  border-radius: 20rpx;
}

.option-title {
  font-size: 27rpx;
  font-weight: 900;
  color: #463f3a;
}

.option-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #82756c;
}

.switch {
  flex: none;
  width: 92rpx;
  height: 50rpx;
  padding: 5rpx;
  background: #e8ddd4;
  border: 2rpx solid rgba(70, 63, 58, 0.12);
  border-radius: 999rpx;
}

.switch.on {
  background: #ffe29b;
}

.switch-dot {
  width: 36rpx;
  height: 36rpx;
  background: #fffdf8;
  border: 2rpx solid rgba(70, 63, 58, 0.14);
  border-radius: 50%;
  transition: transform 160ms ease;
}

.switch.on .switch-dot {
  transform: translateX(40rpx);
}

.modal-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 30rpx;
}

.btn {
  width: 100%;
  min-width: 0;
  height: 78rpx;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
}

.btn.ghost {
  background: #fffdf8;
  border: 2rpx solid rgba(70, 63, 58, 0.26);
}

.btn.primary {
  background: #ffe29b;
  border: 2rpx solid rgba(70, 63, 58, 0.16);
}

.btn.disabled {
  opacity: 0.62;
}

.date-card {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 30rpx 34rpx;
  background: #fffdf8;
  border-radius: 32rpx;
  box-shadow: 0 24rpx 60rpx rgba(70, 63, 58, 0.2);
}

.date-title {
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  color: #463f3a;
}

.date-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  text-align: center;
  color: #82756c;
}

.date-wheel-wrap {
  height: 360rpx;
  margin-top: 28rpx;
  overflow: hidden;
}

.date-wheel {
  width: 100%;
  height: 360rpx;
}

.date-item {
  height: 86rpx;
  line-height: 86rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  color: #463f3a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-indicator {
  height: 86rpx;
  background: rgba(255, 226, 155, 0.28);
  border-top: 2rpx solid rgba(70, 63, 58, 0.08);
  border-bottom: 2rpx solid rgba(70, 63, 58, 0.08);
}

.reminder-date-card {
  max-width: 680rpx;
}

.reminder-wheel-wrap {
  height: 340rpx;
}

.reminder-wheel {
  height: 340rpx;
}

.reminder-item {
  font-size: 25rpx;
  font-weight: 800;
}

.date-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 88rpx;
  margin-top: 30rpx;
  padding: 0 24rpx;
}

.date-btn {
  width: 100%;
  min-width: 0;
  height: 76rpx;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
}

.date-btn.ghost {
  background: #fff7e8;
  border: 3rpx solid rgba(70, 63, 58, 0.45);
}

.date-btn.primary {
  background: #ffe29b;
  border: 3rpx solid rgba(70, 63, 58, 0.45);
}

.date-layer {
  position: fixed;
  inset: 0;
  z-index: 46;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(42, 35, 28, 0.18);
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes pop-in {
  from {
    opacity: 0;
    transform: translateY(16rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

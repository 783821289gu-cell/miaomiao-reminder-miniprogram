.action-layer {
  position: fixed;
  inset: 0;
  z-index: 35;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 56rpx);
  background: rgba(42, 35, 28, 0.26);
}

.action-card {
  width: calc(100vw - 64rpx);
  max-width: 680rpx;
  min-width: 0;
  padding: 20rpx;
  background: #fffdf8;
  border: 3rpx solid rgba(70, 63, 58, 0.16);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 46rpx rgba(70, 63, 58, 0.18);
}

.action-item {
  width: 100%;
  height: 82rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 18rpx;
}

.action-icon {
  width: 42rpx;
  height: 42rpx;
}

.action-item:active {
  background: #fff4dc;
}

.action-item.danger {
  color: #eb5f91;
}

.category-layer {
  position: fixed;
  inset: 0;
  z-index: 30;
  padding: 180rpx 34rpx 0;
  background: rgba(42, 35, 28, 0.35);
}

.category-card {
  padding: 26rpx;
  background: #fffdf8;
  border: 3rpx solid rgba(70, 63, 58, 0.16);
  border-radius: 26rpx;
  box-shadow: 0 18rpx 42rpx rgba(70, 63, 58, 0.18);
}

.category-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.category-item {
  position: relative;
  min-height: 132rpx;
  padding: 18rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 24rpx;
  background: #fffaf0;
  border: 2rpx solid rgba(70, 63, 58, 0.12);
  border-radius: 22rpx;
}

.category-delete-hit {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-delete {
  width: 44rpx;
  height: 44rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #eb5f91;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 44rpx;
  background: #fff0f5;
  border: 2rpx solid rgba(235, 95, 145, 0.2);
  border-radius: 50%;
}

.category-item.active {
  background: #ffe29b;
  border-color: #463f3a;
}

.category-icon {
  width: 48rpx;
  height: 48rpx;
}

.add-mark {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  font-size: 34rpx;
  text-align: center;
  border: 2rpx solid rgba(70, 63, 58, 0.28);
  border-radius: 50%;
}
